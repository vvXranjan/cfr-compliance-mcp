# ---------------------------------------------------------------------------
# cfr-compliance-mcp environment configuration
# Copy this file to `.env` and adjust as needed. All values below are the
# defaults the server falls back to if a variable is not set.
# ---------------------------------------------------------------------------

# --- eCFR API ---------------------------------------------------------------
# Base URL for the official eCFR REST API. No API key is required — the
# eCFR API is fully public. Override only for testing against a mock server.
ECFR_BASE_URL=https://www.ecfr.gov

# Maximum seconds to wait for a single HTTP request to eCFR before timing out.
ECFR_REQUEST_TIMEOUT_SECONDS=30

# --- Retry / backoff ---------------------------------------------------------
# Number of retry attempts for transient failures (timeouts, 5xx, connection errors).
ECFR_MAX_RETRIES=3

# Base delay (seconds) for exponential backoff between retries.
ECFR_RETRY_BACKOFF_BASE_SECONDS=1.0

# --- Client-side rate limiting ------------------------------------------------
# Conservative self-imposed cap to be a good API citizen (eCFR publishes no
# official hard limit, but third-party connectors throttle around 100/60s).
ECFR_MAX_REQUESTS_PER_MINUTE=60

# --- Caching -------------------------------------------------------------------
# Backend selector: "memory" (default, in-process dict) or "redis" (future).
CACHE_BACKEND=memory

# Default time-to-live, in seconds, for cached eCFR responses.
CACHE_TTL_SECONDS=3600

# Only used if CACHE_BACKEND=redis (not required for this milestone).
REDIS_URL=redis://localhost:6379/0

# --- Compliance Memory (deterministic, durable, advisory) ----------------------
# Historical, VERIFIED outcomes are persisted as an append-only JSONL store in
# CFR_MEMORY_DIR and may be used as contextual precedent only -- never as a
# source of regulatory truth. Memory is opt-in and fail-open: when disabled
# (or empty/failing) the pipeline runs authoritative-only.
#
# Unset defaults to false (authoritative-only pipeline).
CFR_MEMORY_ENABLED=true

# Directory for the append-only Compliance Memory store. Empty => default
# <repo-root>/memory. This directory is gitignored (local runtime data).
CFR_MEMORY_DIR=

# --- Logging -------------------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# "json" for machine-parseable structured logs, "text" for human-readable console logs.
# Honored by the MCP server (server.py) and the FastAPI service (api.py).
LOG_FORMAT=text

# --- REST API -------------------------------------------------------------------
# Comma-separated list of allowed CORS origins for the FastAPI service. Default "*".
CORS_ORIGINS=*

# When set, /evaluate-bulk persists an auditable JSON report into this directory.
# Default: unset (no persistence). Persistence failures never fail the request.
CFR_REPORTS_DIR=reports

# --- Persistence backend -------------------------------------------------------
# Backend for analysis/report persistence.
#   - "file" (default): auditable JSON reports via agent.reporting, plus
#     on-disk analysis history. The review workflow is NOT available here.
#   - "postgres": queryable analysis history + the human review workflow,
#     via psycopg 3 (explicit SQL, no ORM). Requires CFR_DATABASE_URL and a
#     migrated schema (see scripts/migrate.py).
# Selection is explicit; there is never a silent fallback.
CFR_PERSISTENCE_BACKEND=file

# PostgreSQL connection string, used when CFR_PERSISTENCE_BACKEND=postgres.
# Apply the schema first: uv run python scripts/migrate.py --dsn "$CFR_DATABASE_URL"
CFR_DATABASE_URL=

# --- OpenTelemetry / Jaeger ------------------------------------------------------
# Best-effort tracing: spans are exported to a Jaeger AGENT over UDP (thrift).
# If the agent is unreachable the app logs a warning and continues serving.
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# --- MCP server ------------------------------------------------------------------
# Transport for the MCP server: "stdio" (default, for local/desktop clients)
# or "streamable-http" (for remote/networked deployment).
MCP_TRANSPORT=stdio

# Only used when MCP_TRANSPORT=streamable-http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000

# --- LLM compliance agent --------------------------------------------------------
# Credential for the LLM-backed compliance evaluation step. ATM_API_KEY is
# the preferred credential (ATM-hosted Nemotron endpoint); OPENAI_API_KEY is
# accepted as a fallback for any OpenAI-compatible endpoint.
#
# Security note: NEVER commit the real key. Keep it in your local `.env` or
# in your environment (export ATM_API_KEY=...). The code only ever reads it
# from the environment -- if a hard-coded key is ever found in source, it
# must be revoked and removed.
ATM_API_KEY=
ATM_BASE_URL=https://atm.accure.ai/v1
ATM_MODEL=nvidia/nemotron-3-nano-omni

# Fallback credential for any OpenAI-compatible endpoint (used only if
# ATM_API_KEY is not set).
OPENAI_API_KEY=
