# ---------------------------------------------------------------------------
# cfr-compliance-mcp environment configuration
# Copy this file to `.env` and adjust as needed. All values below are the
# defaults the server falls back to if a variable is not set.
# ---------------------------------------------------------------------------

# --- eCFR API ---------------------------------------------------------------
# Base URL for the official eCFR REST API. No API key is required — the
# eCFR API is fully public. Override only for testing against a mock server.
ECFR_BASE_URL=https://www.ecfr.gov

# Maximum seconds to wait for a single HTTP request to eCFR before timing out.
ECFR_REQUEST_TIMEOUT_SECONDS=30

# --- Retry / backoff ---------------------------------------------------------
# Number of retry attempts for transient failures (timeouts, 5xx, connection errors).
ECFR_MAX_RETRIES=3

# Base delay (seconds) for exponential backoff between retries.
ECFR_RETRY_BACKOFF_BASE_SECONDS=1.0

# --- Client-side rate limiting ------------------------------------------------
# Conservative self-imposed cap to be a good API citizen (eCFR publishes no
# official hard limit, but third-party connectors throttle around 100/60s).
ECFR_MAX_REQUESTS_PER_MINUTE=60

# --- Caching -------------------------------------------------------------------
# Backend selector: "memory" (default, in-process dict) or "redis" (future).
CACHE_BACKEND=memory

# Default time-to-live, in seconds, for cached eCFR responses.
CACHE_TTL_SECONDS=3600

# Only used if CACHE_BACKEND=redis (not required for this milestone).
REDIS_URL=redis://localhost:6379/0

# --- Logging -------------------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# "json" for machine-parseable structured logs, "text" for human-readable console logs.
LOG_FORMAT=text

# --- MCP server ------------------------------------------------------------------
# Transport for the MCP server: "stdio" (default, for local/desktop clients)
# or "streamable-http" (for remote/networked deployment).
MCP_TRANSPORT=stdio

# Only used when MCP_TRANSPORT=streamable-http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
